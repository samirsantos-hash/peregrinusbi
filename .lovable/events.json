{
  "schema_version": 1,
  "events": {
    "project.diagnostic_recommendation_opened": {
      "event_schema_version": 1,
      "description": "A user opens diagnostic or corrective-action details in seller analysis, or follows an actionable portfolio risk/retention recommendation. Fires on opening only, not passive rendering, closing, filtering, healthy listing details, copying or generic seller links. No identifiers or recommendation text are collected.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_category",
          "dashboard_context"
        ],
        "properties": {
          "recommendation_category": {
            "type": "string",
            "enum": [
              "listing_quality",
              "visibility",
              "inventory",
              "missing_quality_data",
              "growth",
              "logistics",
              "price",
              "promotions",
              "reputation",
              "multiple_issues",
              "revenue_decline",
              "advertising"
            ]
          },
          "dashboard_context": {
            "type": "string",
            "enum": [
              "seller_listing_performance",
              "seller_segment_action_plan",
              "seller_listing_action_plan",
              "seller_quality_index",
              "portfolio_action_plan",
              "portfolio_retention"
            ]
          }
        }
      }
    },
    "project.seller_analysis_opened": {
      "event_schema_version": 1,
      "description": "A user explicitly opens a single-store or listing analysis from portfolio or dashboard navigation, including selecting a real store in the dashboard. No names, IDs or URLs are collected.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_level",
          "source",
          "seller_scope"
        ],
        "properties": {
          "analysis_level": {
            "type": "string",
            "enum": [
              "store",
              "listing"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "portfolio",
              "dashboard",
              "seller_analysis"
            ]
          },
          "seller_scope": {
            "type": "string",
            "enum": [
              "single_store"
            ]
          }
        }
      }
    },
    "project.seller_selection_changed": {
      "event_schema_version": 1,
      "description": "The user changes the selected seller through dashboard or seller-analysis navigation controls, including returning to the dashboard portfolio. Same-seller reselections and listing-only changes do not count. Seller identifiers, names and URLs are excluded.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_view",
          "seller_scope"
        ],
        "properties": {
          "source_view": {
            "type": "string",
            "enum": [
              "dashboard",
              "seller_analysis",
              "portfolio"
            ]
          },
          "seller_scope": {
            "type": "string",
            "enum": [
              "single_store",
              "portfolio"
            ]
          }
        }
      }
    }
  }
}
