            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Máximo de lojas (padrão 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "indicadores_mensais_loja",
        "title": "Indicadores mensais da loja",
        "description": "Retorna faturamento, pedidos, visitas, investimento em Ads e notas de qualidade por mês de uma loja da carteira do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "loja_id": {
              "type": "string",
